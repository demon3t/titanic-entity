      "types": "./dist/dataGridRowContextMenu/index.d.ts",
      "import": "./dist/dataGridRowContextMenu/index.js"
    },
    "./dateInput": {
      "types": "./dist/dateInput/index.d.ts",
      "import": "./dist/dateInput/index.js"
    },
    "./dateTimeInput": {
      "types": "./dist/dateTimeInput/index.d.ts",
      "import": "./dist/dateTimeInput/index.js"
