{
  "name": "@titanic-entity/entity-ui",
  "version": "0.1.0-beta.0",
  "description": "Schema-level UI package bindings and grid configuration for Titanic.Entity.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/demon3t/titanic-entity",
    "directory": "packages/entity-ui"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./components": {
      "types": "./dist/components.d.ts",
      "import": "./dist/components.js"
    },
    "./fields": {
      "types": "./dist/fields.d.ts",
      "import": "./dist/fields.js"
    },
    "./grids": {
      "types": "./dist/grids.d.ts",
      "import": "./dist/grids.js"
    },
    "./templates": {
      "types": "./dist/templates.d.ts",
      "import": "./dist/templates.js"
    },
    "./schemas": {
      "types": "./dist/schemas.d.ts",
      "import": "./dist/schemas.js"
    },
    "./styles.css": "./dist/styles.css",
    "./*/icons": {
      "types": "./dist/*/icons/index.d.ts",
      "import": "./dist/*/icons/index.js"
    },
    "./*/resources": {
      "types": "./dist/*/resources/index.d.ts",
      "import": "./dist/*/resources/index.js"
    },
    "./*": {
      "types": "./dist/*/index.d.ts",
      "import": "./dist/*/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node ../../scripts/copy-css.mjs ./src/styles.css ./dist/styles.css",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@titanic-entity/entity-api": "file:../entity-api",
    "@titanic-entity/entity-base": "file:../entity-base",
    "@titanic-entity/entity-core": "file:../entity-core",
    "@titanic-entity/entity-react": "file:../entity-react",
    "@titanic-entity/entity-resources": "file:../entity-resources"
  },
  "peerDependencies": {
    "react": ">=18.0.0"
  }
}
