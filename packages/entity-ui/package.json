    "./jsonEditor": {
      "types": "./dist/jsonEditor/index.d.ts",
      "import": "./dist/jsonEditor/index.js"
    },
    "./label": {
      "types": "./dist/label/index.d.ts",
      "import": "./dist/label/index.js"
    },
    "./lookupInput": {
      "types": "./dist/lookupInput/index.d.ts",
      "import": "./dist/lookupInput/index.js"
    },
    "./numberInput": {
      "types": "./dist/numberInput/index.d.ts",
      "import": "./dist/numberInput/index.js"
