{
  "name": "@titanic-entity/entity-ui",
  "version": "0.1.0-beta.0",
  "description": "Schema-level UI package bindings and grid configuration for Titanic.Entity.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/demon3t/titanic-entity",
    "directory": "packages/entity-ui"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schemas": {
      "types": "./dist/schemas.d.ts",
      "import": "./dist/schemas.js"
    },
    "./styles.css": "./dist/styles.css",
    "./*/icons": {
      "types": "./dist/*/icons/index.d.ts",
      "import": "./dist/*/icons/index.js"
    },
