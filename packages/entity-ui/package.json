      "types": "./dist/baseSection/index.d.ts",
      "import": "./dist/baseSection/index.js"
    },
    "./baseModalPage": {
      "types": "./dist/baseModalPage/index.d.ts",
      "import": "./dist/baseModalPage/index.js"
    },
    "./button": {
      "types": "./dist/button/index.d.ts",
      "import": "./dist/button/index.js"
    },
    "./container": {
      "types": "./dist/container/index.d.ts",
      "import": "./dist/container/index.js"
    },
    "./dataGrid": {
      "types": "./dist/dataGrid/index.d.ts",
      "import": "./dist/dataGrid/index.js"
    },
    "./dataGridSettingsModalPage": {
      "types": "./dist/dataGridSettingsModalPage/index.d.ts",
      "import": "./dist/dataGridSettingsModalPage/index.js"
    },
