      "import": "./dist/recordsPage/index.js"
    },
    "./resourceSvgIcon": {
      "types": "./dist/resourceSvgIcon/index.d.ts",
      "import": "./dist/resourceSvgIcon/index.js"
    },
    "./siteCollapsiblePanel": {
      "types": "./dist/siteCollapsiblePanel/index.d.ts",
      "import": "./dist/siteCollapsiblePanel/index.js"
    },
    "./siteIconButton": {
      "types": "./dist/siteIconButton/index.d.ts",
      "import": "./dist/siteIconButton/index.js"
