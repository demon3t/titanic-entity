{
  "name": "@titanic-entity/entity-core",
  "version": "0.1.0-beta.0",
  "description": "Core entity schema, model, and React provider primitives for Titanic.Entity.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/demon3t/titanic-entity",
    "directory": "packages/entity-core"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@titanic-entity/entity-api": "file:../entity-api",
    "@titanic-entity/entity-base": "file:../entity-base"
  },
  "peerDependencies": {
    "react": ">=18.0.0"
  }
}
