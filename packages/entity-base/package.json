{
  "name": "@titanic-entity/entity-base",
  "version": "0.1.0",
  "description": "Base package registry and schema helpers for Titanic.Entity UI packages.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/demon3t/titanic-entity",
    "directory": "packages/entity-base"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./enumValues": {
      "types": "./dist/enumValues.d.ts",
      "import": "./dist/enumValues.js"
    },
    "./Titanic": {
      "types": "./dist/Titanic.d.ts",
      "import": "./dist/Titanic.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "react": ">=18.0.0"
  }
}
