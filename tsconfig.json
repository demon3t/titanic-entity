{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "allowJs": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "baseUrl": ".",
    "paths": {
      "@titanic-entity/entity-base": ["packages/entity-base/src/index.ts"],
      "@titanic-entity/entity-base/*": ["packages/entity-base/src/*"],
      "@titanic-entity/entity-api": ["packages/entity-api/src/index.ts"],
      "@titanic-entity/entity-api/*": ["packages/entity-api/src/*"],
      "@titanic-entity/entity-core": ["packages/entity-core/src/index.ts"],
      "@titanic-entity/entity-core/*": ["packages/entity-core/src/*"],
      "@titanic-entity/entity-resources": ["packages/entity-resources/src/index.ts"],
      "@titanic-entity/entity-resources/*": ["packages/entity-resources/src/*"],
      "@titanic-entity/entity-icons": ["packages/entity-icons/src/index.ts"],
      "@titanic-entity/entity-icons/*": ["packages/entity-icons/src/*"],
      "@titanic-entity/entity-react": ["packages/entity-react/src/index.ts"],
      "@titanic-entity/entity-react/*": ["packages/entity-react/src/*"],
      "@titanic-entity/entity-ui": ["packages/entity-ui/src/index.ts"],
      "@titanic-entity/entity-ui/*": ["packages/entity-ui/src/*"]
    },
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx"
  }
}
